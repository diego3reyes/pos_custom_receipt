<?xml version="1.0" encoding="UTF-8"?>
<templates>

    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <xpath expr="//div[button[@title='Download a report with all the sales of the current PoS Session']]" position="after">
            <button class="button btn btn-secondary"
                    t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'"
                    t-if="pos.config.show_corte_z"
                    t-on-click="printCorteZ"
                    title="Imprimir reporte de cierre de caja (Corte Z)">
                Corte Z
                <i t-if="!this.ui.isSmall" class="fa fa-print ms-1" role="img"/>
            </button>
        </xpath>
    </t>

    <t t-name="pos_custom_receipt.CorteZDialog">
        <Dialog contentClass="'corte-z-dialog-content'">
            <t t-set-slot="header">
                <h5 class="mb-0">Vista previa — Corte Z</h5>
            </t>

            <!-- Renderizado en el servidor con la plantilla de pos.config.corte_z_template -->
            <div class="corte-z-receipt" t-out="props.html"/>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="printReceipt">
                    <i class="fa fa-print me-1"/>Imprimir
                </button>
                <button class="btn btn-secondary ms-2" t-on-click="() => props.close()">
                    Cerrar
                </button>
            </t>
        </Dialog>
    </t>

</templates>
