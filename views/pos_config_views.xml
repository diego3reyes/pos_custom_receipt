<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="pos_config_view_form_custom_receipt" model="ir.ui.view">
        <field name="name">pos.config.view.form.custom.receipt</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">

            <!-- Nueva pestaña en el notebook de configuración del POS -->
            <xpath expr="//notebook" position="inside">
                <page string="Ticket Personalizable" name="custom_receipt_page">

                    <!-- COMPORTAMIENTO -->
                    <group string="Comportamiento del POS" name="pos_behavior_config">
                        <field name="show_corte_z"/>
                        <field name="default_partner_id"
                               placeholder="Buscar contacto..."
                               options="{'no_create': True}"/>
                    </group>

                    <!-- CORRELATIVO -->
                    <group string="Correlativo del Ticket" name="ticket_sequence_config">
                        <group>
                            <field name="ticket_prefix" placeholder="Ej: FAC- o TD-"/>
                            <field name="ticket_suffix" placeholder="Opcional"/>
                            <field name="ticket_next_number"/>
                            <field name="ticket_padding"/>
                        </group>
                        <group>
                            <field name="ticket_reset_sequence"/>
                            <div class="text-muted" colspan="2">
                                Formato resultante:
                                <strong>[prefijo][000001][sufijo]</strong>
                            </div>
                        </group>
                    </group>

                    <!-- APARIENCIA -->
                    <group string="Apariencia del Ticket" name="ticket_appearance_config">
                        <group>
                            <field name="ticket_footer_message"
                                   placeholder="Gracias por su compra"/>
                            <field name="show_cashier_on_ticket"/>
                            <field name="show_customer_on_ticket"/>
                        </group>
                        <group>
                            <field name="hide_odoo_branding"/>
                            <field name="hide_tax_on_lines"/>
                        </group>
                    </group>

                    <!-- PLANTILLA PERSONALIZADA -->
                    <group string="Plantilla HTML del Ticket" name="ticket_template_config">
                        <field name="use_custom_template"/>
                        <field name="receipt_template"
                               widget="ace"
                               options="{'mode': 'html'}"
                               invisible="not use_custom_template"
                               placeholder="Escribe aquí tu plantilla HTML personalizada..."/>
                        <div invisible="not use_custom_template" colspan="2">
                            <p class="text-muted">
                                Variables: <code>{{ company.name }}</code>,
                                <code>{{ company.street }}</code>,
                                <code>{{ company.phone }}</code>,
                                <code>{{ company.logo }}</code>,
                                <code>{{ ticket.number }}</code>,
                                <code>{{ ticket.date }}</code>,
                                <code>{{ ticket.time }}</code>,
                                <code>{{ ticket.cashier }}</code>,
                                <code>{{ customer.name }}</code>,
                                <code>{{ totals.subtotal }}</code>,
                                <code>{{ totals.tax_amount }}</code>,
                                <code>{{ totals.total }}</code>,
                                <code>{{ totals.change }}</code>,
                                <code>{{ config.footer_message }}</code>.
                                Líneas: <code>{% for line in lines %}...{% endfor %}</code>.
                                Pagos: <code>{% for payment in payments %}...{% endfor %}</code>.
                            </p>
                        </div>
                    </group>

                    <!-- PLANTILLA DEL CORTE Z -->
                    <group string="Plantilla HTML del Corte Z" name="corte_z_template_config">
                        <field name="corte_z_template"
                               widget="ace"
                               options="{'mode': 'html'}"
                               nolabel="1"
                               colspan="2"/>
                        <div colspan="2">
                            <button name="action_reset_corte_z_template"
                                    type="object"
                                    string="Restaurar plantilla por defecto"
                                    class="btn-link ps-0"
                                    icon="fa-undo"/>
                            <p class="text-muted">
                                Variables: <code>{{ company.name }}</code>,
                                <code>{{ company.vat }}</code>,
                                <code>{{ company.street }}</code>,
                                <code>{{ company.phone }}</code>,
                                <code>{{ company.logo }}</code>,
                                <code>{{ session.name }}</code>,
                                <code>{{ session.config_name }}</code>,
                                <code>{{ session.cashier }}</code>,
                                <code>{{ session.open_time }}</code>,
                                <code>{{ session.close_time }}</code>,
                                <code>{{ totals.orders_count }}</code>,
                                <code>{{ totals.subtotal }}</code>,
                                <code>{{ totals.tax_total }}</code>,
                                <code>{{ totals.total }}</code>.
                                Pagos: <code>{% for payment in payments %}{{ payment.name }} {{ payment.amount }}{% endfor %}</code>.
                                Movimientos de caja: <code>{% for move in cash_moves %}{{ move.name }} {{ move.amount }}{% endfor %}</code>.
                                Clases disponibles: <code>row</code>, <code>center</code>,
                                <code>bold</code>, <code>big</code>.
                            </p>
                            <p class="text-muted">
                                <strong>Resumen de DTE</strong> (solo si el módulo de
                                facturación electrónica está instalado; si no, las
                                secciones salen vacías y el Corte Z funciona igual).
                                Facturas (<code>DTE-01-</code>):
                                <code>{{ dte_summary.fc.count }}</code>,
                                <code>{{ dte_summary.fc.initial }}</code>,
                                <code>{{ dte_summary.fc.final }}</code>,
                                <code>{{ dte_summary.fc.total }}</code>.
                                Créditos fiscales (<code>DTE-03-</code>):
                                <code>{{ dte_summary.ccf.count }}</code>,
                                <code>{{ dte_summary.ccf.initial }}</code>,
                                <code>{{ dte_summary.ccf.final }}</code>,
                                <code>{{ dte_summary.ccf.total }}</code>.
                            </p>
                            <p class="text-muted">
                                Para imprimir <strong>todos</strong> los números de control,
                                recorre la lista completa
                                (<code>dte_summary.fc.documents</code> o
                                <code>dte_summary.ccf.documents</code>); cada documento tiene
                                <code>number</code>, <code>order</code> y <code>amount</code>:
                            </p>
                            <pre class="text-muted small">{% if dte_summary.fc.documents %}
&lt;div class="bold"&gt;DTE EMITIDOS:&lt;/div&gt;
{% for doc in dte_summary.fc.documents %}
&lt;div class="row"&gt;&lt;span&gt;{{ doc.order }}&lt;/span&gt;&lt;span&gt;{{ doc.amount }}&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;{{ doc.number }}&lt;/div&gt;
{% endfor %}
{% endif %}</pre>
                        </div>
                    </group>

                </page>
            </xpath>

        </field>
    </record>
</odoo>
